{
  "name": "atelieroot",
  "version": "2.0.0",
  "description": "Local-first Markdown editor: every document is a .md file in a folder on your computer.",
  "author": "Alejandro Reyes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arphael/AtelieRoot.git"
  },
  "homepage": "https://github.com/Arphael/AtelieRoot#readme",
  "bugs": {
    "url": "https://github.com/Arphael/AtelieRoot/issues"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/atelieroot-server.js --dir ./notas --app src --open",
    "start:dist": "node server/atelieroot-server.js --dir ./notas --app dist --open",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "vendor:prism": "node scripts/vendor-prism.mjs",
    "test:server": "node --test server/test/server.test.mjs server/test/contract.test.mjs",
    "test:unit": "node --test tests/unit/pure.test.mjs",
    "test:e2e": "python tests/run.py --skip-server",
    "test": "npm run check && npm run lint && python tests/run.py",
    "test:dist": "npm run build && python tests/run.py --dist",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "keywords": [
    "markdown",
    "editor",
    "local-first",
    "notes"
  ],
  "files": [
    "src",
    "server",
    "scripts",
    "dist"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
